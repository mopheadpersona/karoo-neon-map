<?xml version="1.0" encoding="UTF-8"?>
<!-- Written by make_karoo_theme.py; do not edit by hand. -->
<!-- GTA VI look for the Karoo 2's own map (day), inspired by the in-game map. -->
<rendertheme xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" map-background="#6D9985"
    version="1" xmlns="http://mapsforge.org/renderTheme"
    xsi:schemaLocation="http://mapsforge.org/renderTheme https://raw.githubusercontent.com/mapsforge/vtm/master/resources/rendertheme.xsd">

    <!-- Land and sea -->
    <m e="way" k="natural" v="issea|sea">
        <area mesh="true" fill="#49A2BA"/>
    </m>
    <m e="way" k="natural" v="nosea">
        <area mesh="true" fill="#6D9985"/>
    </m>

    <!-- Areas, bottom to top. Closed ways that are neither roads nor houses. -->
    <m closed="yes" e="way" k="highway|building" v="~">
        <!-- Town ground -->
        <m k="landuse" v="residential|commercial|retail|industrial|railway|construction|garages|brownfield|quarry|military|education|institutional|religious">
            <area mesh="true" fill="#9EA5AC"/>
        </m>
        <m k="amenity" v="kindergarten|school|college|university|hospital">
            <area mesh="true" fill="#9EA5AC"/>
        </m>
        <m k="aeroway" v="aerodrome">
            <area mesh="true" fill="#9EA5AC"/>
        </m>
        <!-- Forest -->
        <m k="landuse|natural" v="forest|wood">
            <area mesh="true" fill="#5F8C70"/>
        </m>
        <!-- Park, garden, cemetery -->
        <m k="leisure" v="park|garden|golf_course|common|green" zoom-min="12">
            <area mesh="true" fill="#50866D"/>
        </m>
        <m k="landuse" v="village_green|recreation_ground|cemetery" zoom-min="12">
            <area mesh="true" fill="#50866D"/>
        </m>
        <m k="amenity" v="grave_yard" zoom-min="12">
            <area mesh="true" fill="#50866D"/>
        </m>
        <!-- Sand -->
        <m k="natural" v="beach|sand" zoom-min="14">
            <area mesh="true" fill="#E3D5A6"/>
        </m>
        <!-- Wetland -->
        <m k="natural" v="wetland|marsh" zoom-min="14">
            <area mesh="true" fill="#8051ABC3"/>
        </m>
        <!-- Water -->
        <m k="landuse" v="reservoir|basin">
            <area mesh="true" fill="#49A2BA"/>
        </m>
    </m>

    <!-- Water: river banks, docks and lakes -->
    <m e="way" k="waterway" v="riverbank|dock">
        <area mesh="false" fill="#49A2BA"/>
    </m>
    <m e="way" closed="yes" k="natural" v="water">
        <area mesh="true" fill="#49A2BA"/>
    </m>

    <!-- Squares: pedestrian areas -->
    <m e="way" closed="yes" k="highway" v="pedestrian" zoom-min="15">
        <m k="area" v="yes|true">
            <area mesh="true" fill="#D1D2DC"/>
        </m>
    </m>

    <!-- Houses: a flat footprint, and from zoom 17 the ride app's own 3D blocks. The Karoo
         draws those by itself in near-white; this gives them the house colour. -->
    <m e="way" k="building" v="*" zoom-min="15">
        <area mesh="true" fill="#9DACBF"/>
    </m>
    <m e="way" k="building" v="*" zoom-min="17">
        <extrusion line-color="#8794A4" side-color="#8794A4" top-color="#9DACBF"/>
    </m>

    <!-- Line edges (drawn under every fill) -->
    <m e="way" k="tunnel" v="~|false|no">
        <m k="railway" v="rail" select="first">
            <m k="service" v="yard|siding|spur|crossover">
