<?xml version="1.0" encoding="utf-8"?>
<!-- A resource overlay: it holds no code, only new colours and pin pictures for the Karoo's ride app. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="local.karoo.gtavicolours"
    android:versionCode="2"
    android:versionName="0.2">

    <!-- minSdk under 24, or aapt2 drops the -v24 of drawable-anydpi-v24 and the ride app's own pictures win. -->
    <uses-sdk android:minSdkVersion="23" android:targetSdkVersion="27" />

    <overlay
        android:targetPackage="io.hammerhead.rideapp"
        android:priority="1" />

    <application
        android:hasCode="false"
        android:label="GTA VI route colours and pins" />
</manifest>
